{
  "entities": {
    "Service": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Service",
      "type": "object",
      "description": "Represents a service offered by ERG Rénovation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the service."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the service."
        },
        "title": {
          "type": "string",
          "description": "Title of the service."
        },
        "metaTitle": {
          "type": "string",
          "description": "Meta title for SEO."
        },
        "metaDescription": {
          "type": "string",
          "description": "Meta description for SEO."
        },
        "intro": {
          "type": "string",
          "description": "Introductory text for the service."
        },
        "bodyRich": {
          "type": "string",
          "description": "Rich text body content for the service."
        },
        "benefits": {
          "type": "array",
          "description": "Array of benefits offered by the service.",
          "items": {
            "type": "string"
          }
        },
        "process": {
          "type": "array",
          "description": "Array of process steps for the service.",
          "items": {
            "type": "string"
          }
        },
        "faq": {
          "type": "array",
          "description": "Array of frequently asked questions for the service.",
          "items": {
            "type": "string"
          }
        },
        "schemaService": {
          "type": "string",
          "description": "JSON schema for the service."
        },
        "coverImage": {
          "type": "string",
          "description": "URL of the cover image for the service."
        },
        "gallery": {
          "type": "array",
          "description": "Array of image URLs for the service gallery.",
          "items": {
            "type": "string"
          }
        },
        "relatedServices": {
          "type": "array",
          "description": "Array of references to related services.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "metaTitle",
        "metaDescription",
        "intro",
        "bodyRich",
        "benefits",
        "process",
        "faq",
        "schemaService",
        "coverImage",
        "gallery",
        "relatedServices"
      ]
    },
    "Location": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Location",
      "type": "object",
      "description": "Represents a geographical location (city, arrondissement, department, district).",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the location."
        },
        "type": {
          "type": "string",
          "description": "Type of location (city, arrondissement, department, district)."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the location."
        },
        "name": {
          "type": "string",
          "description": "Name of the location."
        },
        "parentId": {
          "type": "string",
          "description": "Reference to parent location. (Relationship: Location 1:N Location)"
        },
        "geo": {
          "type": "string",
          "description": "Geolocation of the location (lat, lng, geoHash)."
        },
        "zones": {
          "type": "array",
          "description": "Array of zones within the location.",
          "items": {
            "type": "string"
          }
        },
        "intro": {
          "type": "string",
          "description": "Introductory text for the location."
        },
        "bodyRich": {
          "type": "string",
          "description": "Rich text body content for the location."
        },
        "faqLocal": {
          "type": "array",
          "description": "Array of local frequently asked questions.",
          "items": {
            "type": "string"
          }
        },
        "schemaLocalBusiness": {
          "type": "string",
          "description": "JSON schema for the local business."
        },
        "popularQueries": {
          "type": "array",
          "description": "Array of popular search queries for the location.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "type",
        "slug",
        "name",
        "parentId",
        "geo",
        "zones",
        "intro",
        "bodyRich",
        "faqLocal",
        "schemaLocalBusiness",
        "popularQueries"
      ]
    },
    "Combo": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Combo",
      "type": "object",
      "description": "Represents a combination of a service and a location.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the combo."
        },
        "serviceId": {
          "type": "string",
          "description": "Reference to the Service. (Relationship: Service 1:N Combo)"
        },
        "locationId": {
          "type": "string",
          "description": "Reference to the Location. (Relationship: Location 1:N Combo)"
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the combo."
        },
        "headline": {
          "type": "string",
          "description": "Headline for the combo page."
        },
        "bodyRich": {
          "type": "string",
          "description": "Rich text body content for the combo."
        },
        "proofs": {
          "type": "array",
          "description": "Array of proofs for the combo.",
          "items": {
            "type": "string"
          }
        },
        "faq": {
          "type": "array",
          "description": "Array of frequently asked questions for the combo.",
          "items": {
            "type": "string"
          }
        },
        "schemaService": {
          "type": "string",
          "description": "JSON schema for the service in the combo."
        }
      },
      "required": [
        "id",
        "serviceId",
        "locationId",
        "slug",
        "headline",
        "bodyRich",
        "proofs",
        "faq",
        "schemaService"
      ]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents a completed project by ERG Rénovation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the project."
        },
        "title": {
          "type": "string",
          "description": "Title of the project."
        },
        "type": {
          "type": "string",
          "description": "Type of project (sdb, cuisine, etc.)."
        },
        "locationId": {
          "type": "string",
          "description": "Reference to the Location. (Relationship: Location 1:N Project)"
        },
        "surface": {
          "type": "number",
          "description": "Surface area of the project."
        },
        "budgetRange": {
          "type": "string",
          "description": "Budget range for the project."
        },
        "duration": {
          "type": "string",
          "description": "Duration of the project."
        },
        "beforeAfter": {
          "type": "array",
          "description": "Array of before and after image URLs.",
          "items": {
            "type": "string"
          }
        },
        "gallery": {
          "type": "array",
          "description": "Array of image URLs for the project gallery.",
          "items": {
            "type": "string"
          }
        },
        "materials": {
          "type": "array",
          "description": "Array of materials used in the project.",
          "items": {
            "type": "string"
          }
        },
        "clientQuote": {
          "type": "string",
          "description": "Quote from the client about the project."
        },
        "bodyRich": {
          "type": "string",
          "description": "Rich text body content for the project."
        },
        "schemaArticle": {
          "type": "string",
          "description": "JSON schema for the project article."
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "type",
        "locationId",
        "surface",
        "budgetRange",
        "duration",
        "beforeAfter",
        "gallery",
        "materials",
        "clientQuote",
        "bodyRich",
        "schemaArticle"
      ]
    },
    "Testimonial": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Testimonial",
      "type": "object",
      "description": "Represents a testimonial from a client.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the testimonial."
        },
        "author": {
          "type": "string",
          "description": "Name of the testimonial author."
        },
        "role": {
          "type": "string",
          "description": "Role of the testimonial author."
        },
        "locationId": {
          "type": "string",
          "description": "Reference to the Location. (Relationship: Location 1:N Testimonial)"
        },
        "rating": {
          "type": "number",
          "description": "Rating given by the client."
        },
        "quote": {
          "type": "string",
          "description": "Text of the testimonial."
        },
        "projectId": {
          "type": "string",
          "description": "Reference to the related project. (Relationship: Project 1:N Testimonial)"
        }
      },
      "required": [
        "id",
        "author",
        "role",
        "locationId",
        "rating",
        "quote"
      ]
    },
    "BlogPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BlogPost",
      "type": "object",
      "description": "Represents a blog post.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the blog post."
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the blog post."
        },
        "title": {
          "type": "string",
          "description": "Title of the blog post."
        },
        "metaTitle": {
          "type": "string",
          "description": "Meta title for SEO."
        },
        "metaDescription": {
          "type": "string",
          "description": "Meta description for SEO."
        },
        "coverImage": {
          "type": "string",
          "description": "URL of the cover image for the blog post."
        },
        "bodyRich": {
          "type": "string",
          "description": "Rich text body content for the blog post."
        },
        "tags": {
          "type": "array",
          "description": "Array of tags for the blog post.",
          "items": {
            "type": "string"
          }
        },
        "faq": {
          "type": "array",
          "description": "Array of frequently asked questions for the blog post.",
          "items": {
            "type": "string"
          }
        },
        "schemaArticle": {
          "type": "string",
          "description": "JSON schema for the blog post article."
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "metaTitle",
        "metaDescription",
        "coverImage",
        "bodyRich",
        "tags",
        "faq",
        "schemaArticle"
      ]
    },
    "Lead": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Lead",
      "type": "object",
      "description": "Represents a lead submitted by a user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the lead."
        },
        "createdAt": {
          "type": "string",
          "description": "Date and time when the lead was created.",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "description": "Source of the lead (site/GBP/ads)."
        },
        "contactName": {
          "type": "string",
          "description": "Name of the contact person."
        },
        "contactEmail": {
          "type": "string",
          "description": "Email address of the contact person.",
          "format": "email"
        },
        "contactPhone": {
          "type": "string",
          "description": "Phone number of the contact person."
        },
        "locationId": {
          "type": "string",
          "description": "Reference to the Location. (Relationship: Location 1:N Lead)"
        },
        "serviceId": {
          "type": "string",
          "description": "Reference to the Service. (Relationship: Service 1:N Lead)"
        },
        "message": {
          "type": "string",
          "description": "Message from the contact person."
        },
        "attachments": {
          "type": "array",
          "description": "Array of attachment URLs.",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "description": "Status of the lead."
        }
      },
      "required": [
        "id",
        "createdAt",
        "source",
        "contactName",
        "contactEmail",
        "contactPhone",
        "locationId",
        "serviceId",
        "message",
        "attachments",
        "status"
      ]
    },
    "Media": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Media",
      "type": "object",
      "description": "Represents media files (images, PDFs) and their metadata.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the media file."
        },
        "domain": {
          "type": "string",
          "description": "Domain or context where the media is used."
        },
        "rights": {
          "type": "string",
          "description": "Copyright or usage rights information."
        },
        "altFR": {
          "type": "string",
          "description": "French alt text for accessibility."
        },
        "focalPoint": {
          "type": "string",
          "description": "Focal point coordinates for image cropping."
        },
        "url": {
          "type": "string",
          "description": "URL of the media file."
        },
        "type": {
          "type": "string",
          "description": "MIME type of the media file (e.g., image/jpeg, application/pdf)."
        },
        "size": {
          "type": "number",
          "description": "Size of the media file in bytes."
        }
      },
      "required": [
        "id",
        "domain",
        "rights",
        "altFR",
        "focalPoint",
        "url",
        "type",
        "size"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/services/{serviceId}",
        "definition": {
          "entityName": "Service",
          "schema": {
            "$ref": "#/backend/entities/Service"
          },
          "description": "Stores services offered by ERG Rénovation.",
          "params": [
            {
              "name": "serviceId",
              "description": "Unique identifier for the service."
            }
          ]
        }
      },
      {
        "path": "/locations/{locationId}",
        "definition": {
          "entityName": "Location",
          "schema": {
            "$ref": "#/backend/entities/Location"
          },
          "description": "Stores geographical locations (city, arrondissement, department, district).",
          "params": [
            {
              "name": "locationId",
              "description": "Unique identifier for the location."
            }
          ]
        }
      },
      {
        "path": "/combos/{comboId}",
        "definition": {
          "entityName": "Combo",
          "schema": {
            "$ref": "#/backend/entities/Combo"
          },
          "description": "Stores combinations of services and locations.",
          "params": [
            {
              "name": "comboId",
              "description": "Unique identifier for the combo."
            }
          ]
        }
      },
      {
        "path": "/projects/{projectId}",
        "definition": {
          "entityName": "Project",
          "schema": {
            "$ref": "#/backend/entities/Project"
          },
          "description": "Stores completed projects by ERG Rénovation.",
          "params": [
            {
              "name": "projectId",
              "description": "Unique identifier for the project."
            }
          ]
        }
      },
      {
        "path": "/testimonials/{testimonialId}",
        "definition": {
          "entityName": "Testimonial",
          "schema": {
            "$ref": "#/backend/entities/Testimonial"
          },
          "description": "Stores testimonials from clients.",
          "params": [
            {
              "name": "testimonialId",
              "description": "Unique identifier for the testimonial."
            }
          ]
        }
      },
      {
        "path": "/blogPosts/{blogPostId}",
        "definition": {
          "entityName": "BlogPost",
          "schema": {
            "$ref": "#/backend/entities/BlogPost"
          },
          "description": "Stores blog posts.",
          "params": [
            {
              "name": "blogPostId",
              "description": "Unique identifier for the blog post."
            }
          ]
        }
      },
      {
        "path": "/leads/{leadId}",
        "definition": {
          "entityName": "Lead",
          "schema": {
            "$ref": "#/backend/entities/Lead"
          },
          "description": "Stores leads submitted by users.  Access to this collection should be restricted to authorized users.",
          "params": [
            {
              "name": "leadId",
              "description": "Unique identifier for the lead."
            }
          ]
        }
      },
      {
        "path": "/media/{mediaId}",
        "definition": {
          "entityName": "Media",
          "schema": {
            "$ref": "#/backend/entities/Media"
          },
          "description": "Stores media files (images, PDFs) and their metadata.",
          "params": [
            {
              "name": "mediaId",
              "description": "Unique identifier for the media file."
            }
          ]
        }
      }
    ],
    "reasoning": "This Firestore structure is designed to support ERG Rénovation's website and CMS needs, focusing on local SEO, content management, and lead capture. The structure prioritizes Authorization Independence through denormalization and Structural Segregation to ensure clarity and security.\n\n**Authorization Independence & Security:**\n\n*   There are no `get()` calls required in the security rules because authorization data such as user roles is stored either directly within documents or can be determined based on the path.\n*   Leads are stored in a separate collection to ensure leads are not publicly accessible. Access to the leads collections is restricted to authorized users.\n\n**QAPs (Rules are not Filters):**\n\n*   The structure supports secure `list` operations by segregating data with different access requirements into separate collections, such as services, locations, and blog posts. This enables filtering and sorting without compromising security. All documents in a collection MUST share the same security requirements."
  }
}