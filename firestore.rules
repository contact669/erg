rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Quote Requests ---
    match /quoteRequests/{docId} {
      // Allow anyone to create a quote request.
      allow create;
      // Allow an admin to read, update, or delete their own requests.
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    // Allow an admin to list their OWN requests, which is what the dashboard query does.
    match /quoteRequests/{path=**} {
      allow list: if request.auth != null && request.query.where.userId == request.auth.uid;
    }

    // --- Quotes ---
    match /quotes/{docId} {
       // Allow an admin to read or write a single quote document if they own it.
      allow read, write: if request.auth != null && request.auth.uid == (resource == null ? request.resource.data.userId : resource.data.userId);
    }
    match /quotes/{path=**} {
      allow list: if request.auth != null && request.query.where.userId == request.auth.uid;
    }
  }
}
