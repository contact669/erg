/**
 * @fileoverview Firestore Security Rules for ERG Rénovation.
 *
 * Core Philosophy:
 * This ruleset provides public read access to all content collections (services, locations, combos, projects, testimonials, blogPosts, media) and restricts write access to prevent unauthorized modification.
 * Leads are kept private, accessible to no one.
 *
 * Data Structure:
 * - /services/{serviceId}
 * - /locations/{locationId}
 * - /combos/{comboId}
 * - /projects/{projectId}
 * - /testimonials/{testimonialId}
 * - /blogPosts/{blogPostId}
 * - /leads/{leadId}
 * - /media/{mediaId}
 *
 * Key Security Decisions:
 * - All content collections are publicly readable.
 * - Leads are private and not accessible.
 * - No authentication or authorization is required for reading content.
 * - Write access to all collections is denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to service documents and denies all write operations.
     * @path /services/{serviceId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public read access to service information, while preventing unauthorized modifications.
     */
    match /services/{serviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to location documents and denies all write operations.
     * @path /locations/{locationId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public read access to location information, while preventing unauthorized modifications.
     */
    match /locations/{locationId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to combo documents and denies all write operations.
     * @path /combos/{comboId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public read access to combo information, while preventing unauthorized modifications.
     */
    match /combos/{comboId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to project documents and denies all write operations.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public read access to project information, while preventing unauthorized modifications.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to testimonial documents and denies all write operations.
     * @path /testimonials/{testimonialId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public read access to testimonial information, while preventing unauthorized modifications.
     */
    match /testimonials/{testimonialId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to blog post documents and denies all write operations.
     * @path /blogPosts/{blogPostId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public read access to blog post information, while preventing unauthorized modifications.
     */
    match /blogPosts/{blogPostId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Denies all access to lead documents, making them completely private.
     * @path /leads/{leadId}
     * @deny get, list, create, update, delete: if true;
     * @principle Ensures leads remain private and inaccessible to any user.
     */
    match /leads/{leadId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to media documents and denies all write operations.
     * @path /media/{mediaId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Allows public read access to media information, while preventing unauthorized modifications.
     */
    match /media/{mediaId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}