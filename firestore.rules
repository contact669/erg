rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonctions d'aide (Helper functions)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Clients
    match /users/{userId}/clients {
      allow list, create: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/clients/{clientId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }

    // Projects
    match /users/{userId}/projects {
      allow list, create: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/projects/{projectId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }

    // Quotes
    match /users/{userId}/quotes {
      allow list, create: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/quotes/{quoteId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }

    // Invoices
    match /users/{userId}/invoices {
      allow list, create: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/invoices/{invoiceId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }

    // 🔑 Collection des rôles d'administrateur
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
