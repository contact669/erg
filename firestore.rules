rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Règle spécifique pour autoriser l'administrateur à lister les demandes de devis
    match /quoteRequests/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }

    // Règle générale pour l'accès administrateur
    match /{path=**} {
      allow get, write: if request.auth != null && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }
  }
}
