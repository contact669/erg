rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Autoriser uniquement l’admin à tout lire/écrire dans Firestore
    match /{document=**} {
      allow read, write: if request.auth != null &&
                         request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }
  }
}
