
/**
 * @fileoverview Firestore Security Rules for ERG Rénovation.
 *
 * Core Philosophy:
 * This ruleset provides public read access to most content collections,
 * restricts write access on them, and secures user-specific data like quotes and requests.
 *
 * Data Structure:
 * - /services/{serviceId}
 * - /locations/{locationId}
 * - /combos/{comboId}
 * - /projects/{projectId}
 * - /testimonials/{testimonialId}
 * - /blogPosts/{blogPostId}
 * - /leads/{leadId} (replaced by quoteRequests)
 * - /media/{mediaId}
 * - /quoteRequests/{requestId}
 * - /quotes/{quoteId}
 *
 * Key Security Decisions:
 * - Public content is readable by anyone.
 * - `quoteRequests` can be created by anyone (public form), but only read/updated by authenticated users (admins).
 * - `quotes` are private and can only be accessed by the authenticated user who owns them.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Public read access for services. Writes are disallowed.
     */
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Public read access for locations. Writes are disallowed.
     */
    match /locations/{locationId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Public read access for combos. Writes are disallowed.
     */
    match /combos/{comboId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Public read access for projects. Writes are disallowed.
     */
    match /projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Public read access for testimonials. Writes are disallowed.
     */
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Public read access for blog posts. Writes are disallowed.
     */
    match /blogPosts/{blogPostId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Denies all access to lead documents, making them completely private.
     * This collection is deprecated in favor of quoteRequests.
     */
    match /leads/{leadId} {
      allow read, write: if false;
    }

    /**
     * @description Public read access for media. Writes are disallowed.
     */
    match /media/{mediaId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Quote requests can be created by anyone, but only read/managed by admins.
     * @path /quoteRequests/{requestId}
     * @principle Allows public form submissions while securing admin access.
     */
    match /quoteRequests/{requestId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    /**
     * @description Quotes are private to the admin user who created them.
     * @path /quotes/{quoteId}
     * @principle A user can only access their own documents.
     */
    match /quotes/{quoteId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
