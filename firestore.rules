rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quoteRequests/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }
    match /quotes/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }
  }
}