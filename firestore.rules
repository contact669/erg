rules_version = '2';
service cloud.firestore {
  match /databases/ergrenov/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }

    // ✅ Lecture publique du contenu (site)
    match /services/{id} { allow read: if true; allow write: if false; }
    match /locations/{id} { allow read: if true; allow write: if false; }
    match /combos/{id} { allow read: if true; allow write: if false; }
    match /projects/{id} { allow read: if true; allow write: if false; }
    match /testimonials/{id} { allow read: if true; allow write: if false; }
    match /blogPosts/{id} { allow read: if true; allow write: if false; }
    match /media/{id} { allow read: if true; allow write: if false; }

    // ❌ ancienne collection privée
    match /leads/{id} { allow read, write: if false; }

    /**
     * ✅ quoteRequests
     * - create: public (form)
     * - read (get + list) / update: admin only
     */
    match /quoteRequests/{requestId} {
      allow create: if true;
      allow get, update: if isAdmin();
      allow delete: if false;
    }
    // ✅ Ajout de la règle de READ (get + list) pour la collection entière
    match /quoteRequests {
      allow read: if isAdmin();
    }


    /**
     * ✅ quotes (devis)
     */
    match /quotes/{quoteId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // 🔒 tout le reste interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
