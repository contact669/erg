/**
 * @fileoverview Firestore Security Rules for ERG Rénovation's BTP management application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Only the owning user can manage their
 * data (clients, projects, quotes, invoices). Administrative privileges are granted based on
 * the existence of a document in the `/roles_admin/{uid}` collection. Certain top-level
 * collections are publicly readable.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the data.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has admin privileges.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- User Data Rules ---

    // -- Clients Subcollection --
    match /users/{userId}/clients/{clientId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/clients {
      allow list, create: if isOwner(userId) || isAdmin();
    }

    // -- Projects Subcollection --
    match /users/{userId}/projects/{projectId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/projects {
      allow list, create: if isOwner(userId) || isAdmin();
    }

    // -- Quotes Subcollection --
    match /users/{userId}/quotes/{quoteId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/quotes {
      allow list, create: if isOwner(userId) || isAdmin();
    }

    // -- Invoices Subcollection --
    match /users/{userId}/invoices/{invoiceId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/invoices {
      allow list, create: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for admin roles.
     */
    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      allow list: if false; // Admins should not be publicly listable
      allow create, delete: if isAdmin();
      allow update: if false; // Roles are atomic, either they exist or they don't
    }

    /**
     * @description Rules for locations. Publicly readable.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for testimonials. Publicly readable.
     */
    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for blog posts. Publicly readable.
     */
    match /blog_posts/{postId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
  }
}
