rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Quote Requests ---
    match /quoteRequests/{docId} {
      // Allow an admin to read or write a single request document if they own it.
      // Allow an admin to list requests if the query filters by their UID and a specific status.
      allow read, write: if request.auth != null && request.auth.uid == (resource == null ? request.resource.data.userId : resource.data.userId);
    }

    // --- Quotes ---
    match /quotes/{docId} {
       // Allow an admin to read or write a single quote document if they own it.
       // Allow an admin to list quotes if the query filters by their UID.
      allow read, write: if request.auth != null && request.auth.uid == (resource == null ? request.resource.data.userId : resource.data.userId);
    }
  }
}
