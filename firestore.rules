rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonctions d'aide (Helper functions)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    // Règle pour la collection 'users'
    match /users/{userId} {
      // Un utilisateur ne peut lire/écrire que dans son propre document.
      // Cela s'applique aux sous-collections ci-dessous.
      allow read, write: if isOwner(userId);

      // Clients
      match /clients/{clientId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
      }
      allow list, create: if isOwner(userId) || isAdmin();
      
      // Projects
      match /projects/{projectId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
      }
      
      // Quotes
      match /quotes/{quoteId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
      }
      
      // Invoices
      match /invoices/{invoiceId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // 🔑 Collection des rôles d'administrateur
    match /roles_admin/{userId} {
      allow read, write: if isAdmin();
    }
  }
}
