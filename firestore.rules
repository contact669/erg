rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }

    match /services/{id} { allow read: if true; allow write: if false; }
    match /locations/{id} { allow read: if true; allow write: if false; }
    match /combos/{id} { allow read: if true; allow write: if false; }
    match /projects/{id} { allow read: if true; allow write: if false; }
    match /testimonials/{id} { allow read: if true; allow write: if false; }
    match /blogPosts/{id} { allow read: if true; allow write: if false; }
    match /media/{id} { allow read: if true; allow write: if false; }

    match /leads/{id} { allow read, write: if false; }

    match /quoteRequests/{requestId} {
      allow create: if true;
      // debug temporaire ok, mais je te conseille isAdmin() ensuite
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    match /quotes/{quoteId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
