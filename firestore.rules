/**
 * @fileoverview Firestore Security Rules for ERG Rénovation's BTP management application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for clients, projects, quotes, and invoices.
 * Only the owning user can read, create, update, or delete their data. Administrative privileges
 * are granted based on the existence of a document in the `/roles_admin/{uid}` collection.
 * Certain top-level collections are publicly readable (locations, testimonials, blog posts).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the data.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has admin privileges.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for user's subcollections (e.g., clients, projects).
     * This rule applies to collection-level operations like 'list' and 'create'.
     */
    match /users/{userId}/{collection} {
      allow list, create: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for individual documents within a user's subcollections.
     * This rule applies to document-level operations like 'get', 'update', 'delete'.
     */
    match /users/{userId}/{collection}/{docId} {
      allow get, update, delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for admin roles.
     */
    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      allow list: if false; // Admins should not be publicly listable
      allow create, delete: if isAdmin();
      allow update: if false; // Roles are atomic, either they exist or they don't
    }

    /**
     * @description Rules for locations. Publicly readable.
     */
    match /locations/{locationId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for testimonials. Publicly readable.
     */
    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for blog posts. Publicly readable.
     */
    match /blog_posts/{postId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
  }
}
