rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow admin to read and write quote requests where their UID matches the document's userId
    match /quoteRequests/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Allow admin to list the quoteRequests collection, but only for their own documents
    match /quoteRequests/{docId} {
       allow list: if request.auth != null && request.auth.uid == request.query.filters.userId;
    }

    // Allow admin to read and write quotes where their UID matches the document's userId
    match /quotes/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Allow admin to list the quotes collection, but only for their own documents
    match /quotes/{docId} {
        allow list: if request.auth != null && request.auth.uid == request.query.filters.userId;
    }
  }
}
