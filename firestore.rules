rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Autoriser l'administrateur à tout lire/écrire.
    // La règle est divisée pour autoriser explicitement les requêtes de liste (list)
    // et la lecture/écriture de documents individuels (get, write).
    match /{path=**} {
      allow read, write: if request.auth != null && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }
  }
}
