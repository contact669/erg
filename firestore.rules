rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Règle pour autoriser l'administrateur à lire et écrire dans la collection de demandes
    match /quoteRequests/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }

    // Règle pour autoriser l'administrateur à lire et écrire dans la collection de devis
    match /quotes/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == "pHcnP0Mc32frrhPRzTT2nFwCxno1";
    }
  }
}
